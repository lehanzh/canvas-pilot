# canvas-pilot settings. `canvas-pilot setup` creates this file for you at:
#   macOS / Linux: ~/.config/canvas-pilot/config.env
#   Windows:       %APPDATA%\canvas-pilot\config.env
# No secrets belong here: the access token is stored in your system keychain.

# Required: the address you see in your browser when using Canvas.
CANVAS_BASE_URL=https://myschool.instructure.com

# Optional: IANA timezone for displayed times (default: this computer's timezone).
# CANVAS_TIMEZONE=America/New_York

# Optional: comma-separated course IDs to leave out of course-wide views
# (orientation shells, advising pages...). Find IDs with the canvas_list_courses tool.
# CANVAS_EXCLUDE_COURSE_IDS=12345,67890

# Optional: set to false to disable the two tools that write to your personal Canvas planner.
# CANVAS_ALLOW_PLANNER_WRITES=true
